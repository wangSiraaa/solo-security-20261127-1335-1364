# 采样固件基线版：普通调用 + 两种互斥运行模式 + 高低两级标记中断。
# frame = 函数自身栈占用（字节）；work = 函数自身执行时间（微秒，不含被调用者）。
# 中断只在 region 标记区间或 irq on 之后开放；调用者被打断时原帧保留。
program sampler {
    mode SAMPLE entry sample_entry;
    mode CALIB  entry calib_entry;

    irq high handler hi_isr arrivals 2 per_period;
    irq low  handler lo_isr arrivals 1 per_period;

    # ---------- 两种互斥模式的前台入口 ----------
    func sample_entry(frame 64 bytes, work 20 us) : mode SAMPLE {
        irq off all;
        call sensor_setup;
        region sample_window open low, high {
            call sensor_read;
            call filter_chain;
        }
        call sensor_store;
    }

    func calib_entry(frame 72 bytes, work 30 us) : mode CALIB {
        irq off all;
        call sensor_setup;
        region calib_window open low, high {
            call sensor_read;
            call calibrate;
        }
        call sensor_store;
    }

    # ---------- 普通调用树（两模式共用的函数不写 mode 限定） ----------
    func sensor_setup(frame 80 bytes, work 150 us) {
        call bus_wake;
        call gpio_prep;
    }

    func bus_wake(frame 40 bytes, work 220 us) {
        call delay_block;
    }

    func gpio_prep(frame 50 bytes, work 180 us) {
    }

    func delay_block(frame 30 bytes, work 400 us) {
    }

    func sensor_read(frame 110 bytes, work 90 us) {
        call adc_shot;
        call dma_xfer;
    }

    func adc_shot(frame 70 bytes, work 160 us) {
    }

    func dma_xfer(frame 90 bytes, work 240 us) {
    }

    func filter_chain(frame 100 bytes, work 80 us) : mode SAMPLE {
        call moving_avg;
        call threshold_check;
    }

    func moving_avg(frame 120 bytes, work 200 us) : mode SAMPLE {
    }

    func threshold_check(frame 60 bytes, work 110 us) : mode SAMPLE {
    }

    func calibrate(frame 96 bytes, work 120 us) : mode CALIB {
        call dac_trim;
    }

    func dac_trim(frame 84 bytes, work 330 us) : mode CALIB {
    }

    func sensor_store(frame 130 bytes, work 70 us) {
        call spi_flush;
    }

    func spi_flush(frame 150 bytes, work 260 us) {
    }

    # ---------- 两级中断（高可打断低，形成嵌套） ----------
    func hi_isr(frame 110 bytes, work 60 us) {
        irq off all;
        call hi_capture;
        irq on high;
    }

    func hi_capture(frame 90 bytes, work 140 us) {
    }

    func lo_isr(frame 100 bytes, work 80 us) {
        irq off all;
        call lo_service;
        region lo_window open high {
            call lo_feed;
        }
        call lo_finish;
    }

    func lo_service(frame 70 bytes, work 170 us) {
    }

    func lo_feed(frame 120 bytes, work 250 us) {
    }

    func lo_finish(frame 60 bytes, work 100 us) {
    }
}
