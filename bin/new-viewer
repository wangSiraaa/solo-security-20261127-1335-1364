#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE="$(cd "$SCRIPT_DIR/.." && pwd)"
export PYTHONPATH="$WORKSPACE${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -c 'from subtitle_sim.cli import new_viewer_main; raise SystemExit(new_viewer_main())' "$@"
